# Copy to /etc/atalaya/atalaya.env and chmod 640, owner root, group atalaya.
# Local Postgres only. Do not put a production URL here.
DATABASE_URL=postgres://atalaya@127.0.0.1:5432/atalaya
HOST=127.0.0.1
PORT=3000
# Optional. Empty means web push is not sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional. Only used by the HTTP watch route, not by the local timer.
WATCH_SECRET=
ATALAYA_BACKUP_DIR=/var/backups/atalaya
# Set only after a domain you control points at this machine. Until then Caddy stays on :80.
# ATALAYA_DOMAIN=example.com
