[Unit]
Description=Atalaya paper tick
After=postgresql.service

[Service]
Type=oneshot
User=atalaya
Group=atalaya
WorkingDirectory=/opt/atalaya
EnvironmentFile=/etc/atalaya/atalaya.env
ExecStart=/opt/atalaya/deploy/oracle/tick-locked.sh paper /usr/bin/node --experimental-strip-types --import /opt/atalaya/scripts/register-ts-ext.mjs /opt/atalaya/scripts/paper-tick.mjs
NoNewPrivileges=true
PrivateTmp=true
